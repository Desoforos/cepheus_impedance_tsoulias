<launch>
    <param name="name" value="testname" />
	<node name="record_topics" pkg="rosbag" type="record" args="-o /home/desoforos/cepheus_impedance_tsoulias/gia_rek/$(arg name).bag  /read_left_shoulder_position
                                                                                                                                        /read_left_elbow_position
                                                                                                                                        /read_right_elbow_position
                                                                                                                                        /read_left_shoulder_velocity
                                                                                                                                        /read_left_elbow_velocity
                                                                                                                                        /read_right_elbow_velocity
                                                                                                                                        /imu/acceleration
                                                                                                                                        /imu/angular_velocity
                                                                                                                                        /bus0/ft_sensor0/ft_sensor_readings/wrench
                                                                                                                                        /vicon/markers
                                                                                                                                        " respawn="true" output="screen"/>
</launch>